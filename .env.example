# MARCUS runtime
MARCUS_HOST=127.0.0.1
MARCUS_PORT=3030
MARCUS_RUNTIME_DIR=./runtime
MARCUS_CONFIG_FILE=./runtime/config.json
MARCUS_ADMIN_TOKEN=

# Optional model providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=

# Optional coding-agent executables
MARCUS_CLAUDE_BIN=claude
MARCUS_CODEX_BIN=codex

# Optional Qdrant memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=marcus-knowledge
